{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 180000,
        "apiKey": "{file:~/.runebench/openrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "quantizations": [
                "fp8",
                "bf16"
              ],
              "require_parameters": true
            }
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "openrouter/z-ai/glm-5.3-flash",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.runebench*": "deny",
      "*openrouter*": "deny",
      "*OPENROUTER*": "deny"
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}
