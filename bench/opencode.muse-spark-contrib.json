{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 180000,
        "apiKey": "{file:~/.runebench/openrouter.key}"
      },
      "models": {
        "meta/muse-spark-1.3-contributor": {}
      }
    }
  },
  "model": "openrouter/meta/muse-spark-1.3-contributor",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.runebench*": "deny",
      "*openrouter*": "deny",
      "*OPENROUTER*": "deny"
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}