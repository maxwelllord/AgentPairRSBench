{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 180000,
        "apiKey": "{file:~/.runebench/openrouter.key}"
      },
      "models": {
        "moonshotai/kimi-k3.1-pro": {
          "options": {
            "provider": {
              "quantizations": [
                "mxfp4",
                "fp8",
                "bf16"
              ],
              "require_parameters": true,
              "only": [
                "moonshotai/mxfp4"
              ]
            }
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "openrouter/moonshotai/kimi-k3.1-pro",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.runebench*": "deny",
      "*openrouter*": "deny",
      "*OPENROUTER*": "deny"
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}
