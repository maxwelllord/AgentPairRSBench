{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "timeout": 180000,
        "apiKey": "{file:~/.runebench/openai.key}"
      },
      "models": {
        "gpt-6.1-terra": {
          "limit": { "context": 400000, "output": 32768 }
        }
      }
    }
  },
  "model": "openai/gpt-6.1-terra",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.runebench*": "deny",
      "*openrouter*": "deny",
      "*OPENROUTER*": "deny",
      "*openai.key*": "deny",
      "*OPENAI*": "deny"
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}
