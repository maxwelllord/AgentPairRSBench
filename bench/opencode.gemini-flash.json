{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 180000,
        "apiKey": "{file:~/.runebench/openrouter.key}"
      },
      "models": {
        "google/gemini-3.8-flash": {}
      }
    }
  },
  "model": "openrouter/google/gemini-3.8-flash",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.runebench*": "deny",
      "*openrouter*": "deny",
      "*OPENROUTER*": "deny"
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}